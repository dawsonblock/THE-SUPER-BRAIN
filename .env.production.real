# Brain-AI Production Environment - Real DeepSeek API
# Version: 4.5.0

# DeepSeek API Configuration
# IMPORTANT: The key that was previously stored here has been removed because it was
# committed to version control and must be treated as exposed.  Rotate it immediately
# at https://platform.deepseek.com/ and set a fresh value before starting the service.
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# API Configuration
API_HOST=0.0.0.0
API_PORT=5001
API_WORKERS=4
API_LOG_LEVEL=info

# OCR Service Configuration
# Canonical OCR port is 6001 (POST /ocr).  8000 was a stale legacy reference.
OCR_HOST=0.0.0.0
OCR_PORT=6001
OCR_WORKERS=2
DEEPSEEK_OCR_MOCK_MODE=false

# GUI Configuration
GUI_PORT=3000
VITE_API_URL=http://localhost:5001

# Production Mode (NO MOCKS/STUBS)
REQUIRE_API_KEY_FOR_WRITES=false
SAFE_MODE=false
LLM_STUB=false
USE_REAL_LLM=true

# Performance
MAX_UPLOAD_SIZE=100MB
CACHE_SIZE=1000
VECTOR_INDEX_SIZE=1000000

# Logging
LOG_DIR=/var/log
LOG_LEVEL=info
LOG_FORMAT=json

# Multi-Agent Configuration
ENABLE_MULTI_AGENT=true
MAX_AGENTS=5
AGENT_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
