# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: build optional C++ native module (brain_ai_core)
# The module is OPTIONAL acceleration.  The REST service runs correctly
# without it via the pure-Python MemoryIndex fallback.
# ─────────────────────────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS builder
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git python3-dev python3-pip ccache ninja-build \
    && rm -rf /var/lib/apt/lists/*

ENV CCACHE_DIR=/ccache
RUN mkdir -p /ccache
WORKDIR /opt/build
COPY brain-ai /opt/build/brain-ai

RUN --mount=type=cache,target=/ccache \
    cd brain-ai && mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_C_COMPILER_LAUNCHER=ccache \
          -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
          -GNinja .. && \
    JOBS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 1)" && \
    cmake --build . -j"${JOBS}" || \
    echo "WARNING: C++ build failed; service will run in pure-Python fallback mode"

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: runtime image
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN adduser --uid 1001 --disabled-password --gecos "" brain
WORKDIR /srv/app

# Copy optional native module build output
COPY --from=builder /opt/build/brain-ai/build/python /srv/app/native_build

COPY brain-ai-rest-service/requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements.txt

COPY brain-ai-rest-service /srv/app/brain-ai-rest-service
RUN set -e; \
    mkdir -p /srv/app/brain-ai-rest-service; \
    if ls /srv/app/native_build/brain_ai_core*.so >/dev/null 2>&1; then \
        cp /srv/app/native_build/brain_ai_core*.so /srv/app/brain-ai-rest-service/ && \
        echo "brain_ai_core native module installed (optional acceleration)"; \
    else \
        echo "brain_ai_core not built — service will use pure-Python fallback (this is normal)"; \
    fi
WORKDIR /srv/app/brain-ai-rest-service

# Default dev-safe environment; override at runtime for production
ENV SAFE_MODE=1 \
    LLM_STUB=1 \
    EMBEDDINGS_BACKEND=cpu \
    API_KEY=devkey \
    REQUIRE_API_KEY_FOR_WRITES=1 \
    OCR_URL=http://ocr:6001/ocr

USER brain
EXPOSE 5001 9090
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5001/healthz || exit 1

# Canonical entry point — app.app_v2 is the single authoritative runtime
CMD ["uvicorn", "app.app_v2:app", "--host", "0.0.0.0", "--port", "5001"]
